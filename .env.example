#
# cPanel / production SMTP tuning (works with Google SMTP when the host allows it):
# - Set APP_URL to your real public URL (used as EHLO / local_domain fallback).
# - MAIL_EHLO_DOMAIN=yourdomain.com
# - MAIL_TIMEOUT=60
# - MAIL_VERIFY_PEER=true
# If 587/TLS fails on shared hosting, try Gmail on implicit SSL:
# MAIL_PORT=465
# MAIL_ENCRYPTION=ssl
# If the server has a broken CA bundle and TLS fails with certificate errors:
# MAIL_VERIFY_PEER=false
#
# If outbound SMTP to external providers is blocked, use a cPanel mailbox + localhost relay:
# MAIL_MAILER=cpanel_smtp
# MAIL_CPANEL_HOST=localhost
# MAIL_CPANEL_PORT=587
# MAIL_CPANEL_ENCRYPTION=tls
# MAIL_CPANEL_USERNAME="mailbox@yourdomain.com"
# MAIL_CPANEL_PASSWORD="..."

