APP_NAME=Laravel
APP_ENV=local
APP_KEY=base64:nWndLx20um+anSdcDDeU5NAxgYIQvgK2UhRcDZTvxTw=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=template_db
DB_USERNAME=root
DB_PASSWORD=123

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Mail (local: Gmail / Google Workspace SMTP) ---
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=your-account@gmail.com
# MAIL_PASSWORD="app-password"
# MAIL_ENCRYPTION=tls
# MAIL_TIMEOUT=60
# MAIL_EHLO_DOMAIN=litusgroup.com
# MAIL_FROM_ADDRESS="noreply@litusgroup.com"
# MAIL_FROM_NAME="Litus Group"
# MAIL_CONTACT_RECIPIENT="info@litusgroup.com"
# MAIL_CAREERS_RECIPIENT="hr@litusgroup.mv"
#
# --- Mail (cPanel / shared hosting — use when Gmail SMTP works locally but not on the server) ---
# Many hosts block outbound SMTP to Google. Use the server’s mail (recommended) or sendmail.
#
# Option A — SMTP to this server (create the mailbox in cPanel → Email Accounts):
# If localhost fails, try MAIL_HOST=mail.yourdomain.com (see cPanel → Email Routing / server hostname).
# MAIL_MAILER=smtp
# MAIL_HOST=localhost
# MAIL_PORT=587
# MAIL_USERNAME=info@litusgroup.com
# MAIL_PASSWORD="cpanel-email-password"
# MAIL_ENCRYPTION=tls
# MAIL_EHLO_DOMAIN=litusgroup.com
# MAIL_FROM_ADDRESS="info@litusgroup.com"
# MAIL_FROM_NAME="Litus Group"
#
# Option B — sendmail (often enabled on cPanel Linux):
# MAIL_MAILER=sendmail
# MAIL_FROM_ADDRESS="info@litusgroup.com"
# MAIL_FROM_NAME="Litus Group"
#
# If TLS fails with “certificate verify failed”, try only after Option A/B:
# MAIL_SMTP_ALLOW_INSECURE=true
#
# After changing .env on the server, run: php artisan config:clear

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
